{
  "name": "smd-monolith",
  "version": "1.0.0",
  "description": "Flavor Haus Monolith - All features in one NestJS application",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "20.x"
  },
  "author": "",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && copyfiles -u 1 src/email_templates/**/* dist/",
    "start": "node dist/main.js",
    "start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node -r dotenv/config dist/main.js dotenv_config_path=./.env\"",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest --config ./test/jest-e2e.json --detectOpenHandles"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.186.0",
    "@azure/communication-email": "^1.0.0",
    "@azure/storage-blob": "^12.27.0",
    "@nestjs/axios": "^1.0.0",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^2.2.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^9.2.0",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/schedule": "^2.1.0",
    "@nestjs/swagger": "^6.1.2",
    "@nestjs-modules/mailer": "^1.8.1",
    "@types/validator": "^13.7.10",
    "bcryptjs": "^2.4.3",
    "cache-manager": "^4.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "copyfiles": "^2.4.1",
    "date-fns": "^2.29.3",
    "ejs": "^3.1.8",
    "express-basic-auth": "^1.2.1",
    "express": "^4.18.2",
    "handlebars": "^4.7.7",
    "joi": "^17.6.2",
    "lodash": "^4.17.21",
    "nest-winston": "^1.7.1",
    "nodemailer": "^6.8.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "stripe": "^11.4.0",
    "uuid": "^9.0.0",
    "winston": "^3.8.2",
    "winston-cloudwatch": "^6.1.1"
  },
  "devDependencies": {
    "@nestjs/testing": "9.1.2",
    "@types/bcryptjs": "^2.4.2",
    "@types/cache-manager": "^4.0.2",
    "@types/express": "4.17.14",
    "@types/jest": "29.1.1",
    "@types/lodash": "^4.14.191",
    "@types/multer": "^1.4.7",
    "@types/node": "18.8.1",
    "@types/nodemailer": "^6.4.7",
    "@types/supertest": "2.0.12",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "5.39.0",
    "@typescript-eslint/parser": "5.39.0",
    "dotenv": "16.0.3",
    "eslint": "8.24.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "29.1.2",
    "mongoose": "6.6.4",
    "prettier": "2.7.1",
    "supertest": "6.3.0",
    "ts-jest": "29.0.3",
    "ts-node": "10.9.1",
    "tsc-watch": "5.0.3",
    "tsconfig-paths": "4.1.0",
    "typescript": "4.8.4"
  }
}
