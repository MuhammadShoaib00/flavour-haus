<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100;200;300;400;500;600;700&family=Roboto:wght@100;300;400;500&display=swap"
        rel="stylesheet">
    <style>
        .template-body {
            padding: 88px 114px;
        }

        .template-content {
            border-radius: 30px;
        }

        .email-paragraph {
            font-size: 22px;
            padding: 0 180px;
        }

        .verify-button {
            height: 50px;
            width: 306px;
        }

        @media only screen and (max-width: 786px) {
            .template-body {
                padding: 28px 24px;
            }

            .template-content {
                border-radius: 15px;
            }

            .verify-button {
                height: 40px;
                width: 230px;
            }
        }

        @media only screen and (max-width: 986px) {
            .email-paragraph {
                font-size: 18px;
                padding: 0 30px;
            }
        }
    </style>
    <title>Email</title>
</head>

<body style="font-family: 'Roboto';  text-align: center;">
    <main>
        <div class="main-container" style="display: flex; align-items: center; justify-content: center;">
            
            <div class="template-body" style="background: #F5F8FE; display: flex; align-items: center; justify-content: center; border-radius: 30px;">
                <div class="template-content"
                    style="padding-top: 55px; padding-bottom: 70px; background: #FFFFFF; display: flex; align-items: center; justify-content: center; flex-direction: column;">
                    <div class="smd-logo" style="margin-bottom: 80px;">
                        <img src="https://smd-s3-public-dev-001.s3.eu-west-2.amazonaws.com/icons/smd_logo.png" alt="smd-logo">
                    </div>