# Environment
NODE_ENV=development

# Application
GATEWAY_BASE_URI=http://localhost:8000
GATEWAY_PORT=8000
SWAGGER_AUTH=false
PERMISSION_SYNC=true

# MongoDB
MONGO_DSN=mongodb+srv://smd:password@smd.example.mongodb.net
MONGO_DATABASE=smd

# JWT
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-refresh-secret

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=your-account-name
AZURE_STORAGE_ACCOUNT_KEY=your-account-key
AZURE_STORAGE_CONTAINER_NAME=your-container-name

# Azure Communication Services
ACS_CONNECTION_STRING=endpoint=https://...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_CURRENCY=gbp

# ContractBook
CONTRACT_BOOK_API_KEY=your-api-key
CONTRACT_BOOK_URL=https://api.contractbook.com
CONTRACT_BOOK_TEMPLATE_NAME=your-template-name
CONTRACT_BOOK_TEMPLATE_ID=your-template-id

# AAC Lead Generation
AAC_API_URL=https://api.example.com
AAC_API_KEY=your-aac-key

# Nutritionix
NUTRITIONIX_BASE_URL=https://trackapi.nutritionix.com/v2
NUTRITIONIX_APP_ID=your-app-id
NUTRITIONIX_APP_KEY=your-app-key
